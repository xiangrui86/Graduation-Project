{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { getOrders } from '@/api/admin';\nexport default {\n  name: 'AdminOrders',\n  data: function data() {\n    return {\n      list: [],\n      page: 0,\n      total: 0\n    };\n  },\n  created: function created() {\n    this.load();\n  },\n  methods: {\n    statusText: function statusText(s) {\n      var map = {\n        PENDING: '待支付',\n        PAID: '已支付',\n        SHIPPED: '已发货',\n        RECEIVED: '已收货',\n        CANCELLED: '已取消'\n      };\n      return map[s] || s;\n    },\n    load: function load() {\n      var _this = this;\n      getOrders({\n        page: this.page,\n        size: 10\n      }).then(function (res) {\n        if (res.data && res.data.content) {\n          _this.list = res.data.content;\n          _this.total = res.data.totalElements || 0;\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["getOrders","name","data","list","page","total","created","load","methods","statusText","s","map","PENDING","PAID","SHIPPED","RECEIVED","CANCELLED","_this","size","then","res","content","totalElements"],"sources":["src/views/admin/Orders.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>交易管理</h2>\r\n    <el-table :data=\"list\" border>\r\n      <el-table-column prop=\"orderNo\" label=\"订单号\" width=\"180\" />\r\n      <el-table-column prop=\"userId\" label=\"用户ID\" width=\"80\" />\r\n      <el-table-column prop=\"merchantId\" label=\"商家ID\" width=\"80\" />\r\n      <el-table-column prop=\"totalAmount\" label=\"金额\" width=\"100\" />\r\n      <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\r\n        <template slot-scope=\"scope\">\r\n          {{ statusText(scope.row.status) }}\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column prop=\"createdAt\" label=\"下单时间\" />\r\n    </el-table>\r\n    <el-pagination\r\n      v-if=\"total > 10\"\r\n      :current-page=\"page + 1\"\r\n      :page-size=\"10\"\r\n      :total=\"total\"\r\n      layout=\"prev, pager, next\"\r\n      @current-change=\"p => { page = p - 1; load() }\"\r\n    />\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getOrders } from '@/api/admin'\r\n\r\nexport default {\r\n  name: 'AdminOrders',\r\n  data() {\r\n    return { list: [], page: 0, total: 0 }\r\n  },\r\n  created() {\r\n    this.load()\r\n  },\r\n  methods: {\r\n    statusText(s) {\r\n      const map = { PENDING: '待支付', PAID: '已支付', SHIPPED: '已发货', RECEIVED: '已收货', CANCELLED: '已取消' }\r\n      return map[s] || s\r\n    },\r\n    load() {\r\n      getOrders({ page: this.page, size: 10 }).then(res => {\r\n        if (res.data && res.data.content) {\r\n          this.list = res.data.content\r\n          this.total = res.data.totalElements || 0\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;AA2BA,SAAAA,SAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MAAAC,IAAA;MAAAC,IAAA;MAAAC,KAAA;IAAA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAC,UAAA,WAAAA,WAAAC,CAAA;MACA,IAAAC,GAAA;QAAAC,OAAA;QAAAC,IAAA;QAAAC,OAAA;QAAAC,QAAA;QAAAC,SAAA;MAAA;MACA,OAAAL,GAAA,CAAAD,CAAA,KAAAA,CAAA;IACA;IACAH,IAAA,WAAAA,KAAA;MAAA,IAAAU,KAAA;MACAjB,SAAA;QAAAI,IAAA,OAAAA,IAAA;QAAAc,IAAA;MAAA,GAAAC,IAAA,WAAAC,GAAA;QACA,IAAAA,GAAA,CAAAlB,IAAA,IAAAkB,GAAA,CAAAlB,IAAA,CAAAmB,OAAA;UACAJ,KAAA,CAAAd,IAAA,GAAAiB,GAAA,CAAAlB,IAAA,CAAAmB,OAAA;UACAJ,KAAA,CAAAZ,KAAA,GAAAe,GAAA,CAAAlB,IAAA,CAAAoB,aAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}