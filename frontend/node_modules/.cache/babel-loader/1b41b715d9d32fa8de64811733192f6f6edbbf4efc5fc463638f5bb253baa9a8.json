{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { getAnnouncements } from '@/api/pub';\nexport default {\n  name: 'Announcements',\n  data: function data() {\n    return {\n      list: []\n    };\n  },\n  created: function created() {\n    var _this = this;\n    getAnnouncements(20).then(function (res) {\n      if (res.data) _this.list = res.data;\n    });\n  }\n};","map":{"version":3,"names":["getAnnouncements","name","data","list","created","_this","then","res"],"sources":["src/views/user/Announcements.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>最新公告</h2>\r\n    <el-card v-for=\"a in list\" :key=\"a.id\" class=\"item\">\r\n      <h4>{{ a.title }}</h4>\r\n      <p class=\"time\">{{ a.createdAt }}</p>\r\n      <p class=\"content\">{{ a.content }}</p>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getAnnouncements } from '@/api/pub'\r\n\r\nexport default {\r\n  name: 'Announcements',\r\n  data() {\r\n    return { list: [] }\r\n  },\r\n  created() {\r\n    getAnnouncements(20).then(res => { if (res.data) this.list = res.data })\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.item { margin-bottom: 16px; }\r\n.time { color: #999; font-size: 12px; }\r\n.content { margin-top: 8px; color: #666; }\r\n</style>\r\n"],"mappings":";;;;;;;;;;;;AAYA,SAAAA,gBAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MAAAC,IAAA;IAAA;EACA;EACAC,OAAA,WAAAA,QAAA;IAAA,IAAAC,KAAA;IACAL,gBAAA,KAAAM,IAAA,WAAAC,GAAA;MAAA,IAAAA,GAAA,CAAAL,IAAA,EAAAG,KAAA,CAAAF,IAAA,GAAAI,GAAA,CAAAL,IAAA;IAAA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}