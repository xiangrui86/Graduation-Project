{"ast":null,"code":"import \"core-js/modules/es.array.find.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.object.to-string.js\";\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { getOrders, shipOrder } from '@/api/merchant';\nexport default {\n  name: 'MerchantOrders',\n  data: function data() {\n    return {\n      list: []\n    };\n  },\n  created: function created() {\n    var _this = this;\n    getOrders({\n      page: 0,\n      size: 50\n    }).then(function (res) {\n      if (res.data && res.data.content) _this.list = res.data.content;\n    });\n  },\n  methods: {\n    statusText: function statusText(s) {\n      var map = {\n        PENDING: '待支付',\n        PAID: '已支付',\n        SHIPPED: '已发货',\n        RECEIVED: '已收货'\n      };\n      return map[s] || s;\n    },\n    ship: function ship(id) {\n      var _this2 = this;\n      shipOrder(id).then(function (res) {\n        if (res.code === 200) {\n          _this2.$message.success('已发货');\n          _this2.list.find(function (o) {\n            return o.id === id;\n          }).status = 'SHIPPED';\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["getOrders","shipOrder","name","data","list","created","_this","page","size","then","res","content","methods","statusText","s","map","PENDING","PAID","SHIPPED","RECEIVED","ship","id","_this2","code","$message","success","find","o","status"],"sources":["src/views/merchant/Orders.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>交易管理</h2>\r\n    <el-table :data=\"list\" border>\r\n      <el-table-column prop=\"orderNo\" label=\"订单号\" width=\"180\" />\r\n      <el-table-column prop=\"totalAmount\" label=\"金额\" width=\"100\" />\r\n      <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\r\n        <template slot-scope=\"scope\">\r\n          {{ statusText(scope.row.status) }}\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column prop=\"createdAt\" label=\"下单时间\" />\r\n      <el-table-column label=\"操作\" width=\"120\">\r\n        <template slot-scope=\"scope\">\r\n          <el-button v-if=\"scope.row.status === 'PAID'\" size=\"small\" type=\"primary\" @click=\"ship(scope.row.id)\">发货</el-button>\r\n        </template>\r\n      </el-table-column>\r\n    </el-table>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getOrders, shipOrder } from '@/api/merchant'\r\n\r\nexport default {\r\n  name: 'MerchantOrders',\r\n  data() {\r\n    return { list: [] }\r\n  },\r\n  created() {\r\n    getOrders({ page: 0, size: 50 }).then(res => {\r\n      if (res.data && res.data.content) this.list = res.data.content\r\n    })\r\n  },\r\n  methods: {\r\n    statusText(s) {\r\n      const map = { PENDING: '待支付', PAID: '已支付', SHIPPED: '已发货', RECEIVED: '已收货' }\r\n      return map[s] || s\r\n    },\r\n    ship(id) {\r\n      shipOrder(id).then(res => {\r\n        if (res.code === 200) {\r\n          this.$message.success('已发货')\r\n          this.list.find(o => o.id === id).status = 'SHIPPED'\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;AAsBA,SAAAA,SAAA,EAAAC,SAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MAAAC,IAAA;IAAA;EACA;EACAC,OAAA,WAAAA,QAAA;IAAA,IAAAC,KAAA;IACAN,SAAA;MAAAO,IAAA;MAAAC,IAAA;IAAA,GAAAC,IAAA,WAAAC,GAAA;MACA,IAAAA,GAAA,CAAAP,IAAA,IAAAO,GAAA,CAAAP,IAAA,CAAAQ,OAAA,EAAAL,KAAA,CAAAF,IAAA,GAAAM,GAAA,CAAAP,IAAA,CAAAQ,OAAA;IACA;EACA;EACAC,OAAA;IACAC,UAAA,WAAAA,WAAAC,CAAA;MACA,IAAAC,GAAA;QAAAC,OAAA;QAAAC,IAAA;QAAAC,OAAA;QAAAC,QAAA;MAAA;MACA,OAAAJ,GAAA,CAAAD,CAAA,KAAAA,CAAA;IACA;IACAM,IAAA,WAAAA,KAAAC,EAAA;MAAA,IAAAC,MAAA;MACArB,SAAA,CAAAoB,EAAA,EAAAZ,IAAA,WAAAC,GAAA;QACA,IAAAA,GAAA,CAAAa,IAAA;UACAD,MAAA,CAAAE,QAAA,CAAAC,OAAA;UACAH,MAAA,CAAAlB,IAAA,CAAAsB,IAAA,WAAAC,CAAA;YAAA,OAAAA,CAAA,CAAAN,EAAA,KAAAA,EAAA;UAAA,GAAAO,MAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"m