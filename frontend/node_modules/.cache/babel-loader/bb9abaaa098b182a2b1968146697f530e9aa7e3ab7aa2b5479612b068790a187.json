{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.number.constructor.js\";\nimport \"core-js/modules/es.string.trim.js\";\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { getChatList, sendChat } from '@/api/merchant';\nexport default {\n  name: 'MerchantChat',\n  data: function data() {\n    return {\n      targetUserId: '',\n      messages: [],\n      inputMsg: '',\n      meId: null\n    };\n  },\n  created: function created() {\n    this.meId = this.$store.state.user && this.$store.state.user.userId;\n  },\n  methods: {\n    loadChat: function loadChat() {\n      var _this = this;\n      if (!this.targetUserId) return;\n      getChatList(this.targetUserId).then(function (res) {\n        if (res.data) _this.messages = res.data;\n      });\n    },\n    send: function send() {\n      var _this2 = this;\n      if (!this.inputMsg.trim()) return;\n      sendChat({\n        receiverId: Number(this.targetUserId),\n        content: this.inputMsg\n      }).then(function (res) {\n        if (res.code === 200) {\n          _this2.messages.push(res.data);\n          _this2.inputMsg = '';\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["getChatList","sendChat","name","data","targetUserId","messages","inputMsg","meId","created","$store","state","user","userId","methods","loadChat","_this","then","res","send","_this2","trim","receiverId","Number","content","code","push"],"sources":["src/views/merchant/Chat.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>客服消息</h2>\r\n    <p>请输入用户ID进行对话：</p>\r\n    <el-input v-model=\"targetUserId\" placeholder=\"用户ID\" style=\"width:200px;margin-right:8px\" />\r\n    <el-button type=\"primary\" @click=\"loadChat\">加载对话</el-button>\r\n    <div v-if=\"targetUserId\" class=\"chat-box\">\r\n      <div v-for=\"m in messages\" :key=\"m.id\" :class=\"['msg', m.senderId === meId ? 'me' : 'other']\">\r\n        {{ m.content }}\r\n      </div>\r\n      <el-input v-model=\"inputMsg\" type=\"textarea\" placeholder=\"输入消息\" style=\"margin-top:12px\" />\r\n      <el-button type=\"primary\" style=\"margin-top:8px\" @click=\"send\">发送</el-button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getChatList, sendChat } from '@/api/merchant'\r\n\r\nexport default {\r\n  name: 'MerchantChat',\r\n  data() {\r\n    return {\r\n      targetUserId: '',\r\n      messages: [],\r\n      inputMsg: '',\r\n      meId: null\r\n    }\r\n  },\r\n  created() {\r\n    this.meId = this.$store.state.user && this.$store.state.user.userId\r\n  },\r\n  methods: {\r\n    loadChat() {\r\n      if (!this.targetUserId) return\r\n      getChatList(this.targetUserId).then(res => {\r\n        if (res.data) this.messages = res.data\r\n      })\r\n    },\r\n    send() {\r\n      if (!this.inputMsg.trim()) return\r\n      sendChat({ receiverId: Number(this.targetUserId), content: this.inputMsg }).then(res => {\r\n        if (res.code === 200) {\r\n          this.messages.push(res.data)\r\n          this.inputMsg = ''\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.chat-box { margin-top: 16px; padding: 16px; border: 1px solid #eee; border-radius: 8px; }\r\n.msg { margin: 6px 0; padding: 8px; border-radius: 4px; max-width: 80%; }\r\n.msg.me { background: #409EFF; color: #fff; margin-left: auto; }\r\n.msg.other { background: #f0f0f0; }\r\n</style>\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;AAiBA,SAAAA,WAAA,EAAAC,QAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,YAAA;MACAC,QAAA;MACAC,QAAA;MACAC,IAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAD,IAAA,QAAAE,MAAA,CAAAC,KAAA,CAAAC,IAAA,SAAAF,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAC,MAAA;EACA;EACAC,OAAA;IACAC,QAAA,WAAAA,SAAA;MAAA,IAAAC,KAAA;MACA,UAAAX,YAAA;MACAJ,WAAA,MAAAI,YAAA,EAAAY,IAAA,WAAAC,GAAA;QACA,IAAAA,GAAA,CAAAd,IAAA,EAAAY,KAAA,CAAAV,QAAA,GAAAY,GAAA,CAAAd,IAAA;MACA;IACA;IACAe,IAAA,WAAAA,KAAA;MAAA,IAAAC,MAAA;MACA,UAAAb,QAAA,CAAAc,IAAA;MACAnB,QAAA;QAAAoB,UAAA,EAAAC,